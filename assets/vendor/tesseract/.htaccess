# Lector de texto en el celular (Tesseract, assets/js/list_ocr.js).
# .wasm con su tipo (el navegador lo compila mientras baja) y el idioma .gz sin Content-Encoding: el lector lo descomprime.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    RemoveEncoding .gz
    AddType application/octet-stream .gz
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(wasm|gz)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
